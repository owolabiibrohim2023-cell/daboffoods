# DABOFFOODS & LOGISTICS SERVICES - Environment Configuration
# Copy this file to .env.local for local development or set in Vercel Dashboard
# NEVER commit actual secrets to version control!

# ============================================================
# FIREBASE CONFIGURATION (Required for ALL backend endpoints)
# ============================================================
# Option 1: Full service account JSON (RECOMMENDED for Vercel)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the ENTIRE JSON as a single-line value in Vercel env var FIREBASE_SERVICE_ACCOUNT_KEY
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"fl-logistics-ce201","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@fl-logistics-ce201.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40fl-logistics-ce201.iam.gserviceaccount.com"}

# Option 2: Split variables (legacy, still supported)
# FIREBASE_PROJECT_ID=fl-logistics-ce201
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fl-logistics-ce201.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================
# PAYSTACK CONFIGURATION (Required for payments)
# ============================================================
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
# Test keys: pk_test_xxxxx / sk_test_xxxxx
# Live keys: pk_live_xxxxx / sk_live_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx  # NEVER expose in frontend!
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx  # Used in frontend app.js CONFIG.paystackPublicKey

# ============================================================
# SITE CONFIGURATION (Required for Paystack callback URL)
# ============================================================
# Your live HTTPS domain (no trailing slash)
# Local: http://localhost:3000 (or your local dev server)
# Production: https://your-domain.vercel.app or https://your-custom-domain.com
SITE_URL=https://your-deployed-domain.vercel.app

# ============================================================
# UPS CONFIGURATION (Required for shipment tracking)
# ============================================================
# Get from: UPS Developer Portal → Applications → My Applications
UPS_CLIENT_ID=your_ups_client_id
UPS_CLIENT_SECRET=your_ups_client_secret
UPS_ENVIRONMENT=sandbox  # or 'production' for live

# ============================================================
# OPTIONAL: EMAILJS (Fallback if Cloud Functions not deployed)
# ============================================================
# EMAILJS_ENABLED=false
# EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id