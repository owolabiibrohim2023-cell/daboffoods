{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "functions/**",
      ".env",
      ".env.*",
      ".git/**",
      ".vscode/**",
      "node_modules/**",
      "backup-2026-11-05/**",
      "api/**",
      "scripts/**",
      "ADMIN-SETUP-VERCEL.md",
      "WEBSITE-CLEANUP-REPORT.md",
      "FIREBASE-PAYMENTS-TRACKING.md",
      "README.md"
    ],
    "cleanUrls": false
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}