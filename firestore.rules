rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */
    function signedIn() { return request.auth != null; }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && myData().role == 'admin' && myData().get('disabled', false) != true;
    }
    function isRider() {
      return hasProfile() && myData().role == 'rider' && myData().get('disabled', false) != true;
    }

    /* ---------- Users & saved addresses ---------- */
    match /users/{uid} {
      // Own profile, or admin. Admins can list customers/riders.
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      // Self sign-up can only create a CUSTOMER profile.
      // Admins create rider profiles from the dashboard.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'customer'
            && request.resource.data.get('disabled', false) == false);

      // Non-admins cannot change their own role or disabled flag.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));

      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);

      match /addresses/{addressId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    /* ---------- Orders ---------- */
    match /orders/{orderId} {
      // Guest shipment lookup is served by a rate-limited callable that returns
      // a sanitized projection, never by exposing a raw order document.
      allow get: if isAdmin()
        || (signedIn() && (resource.data.customerUid == request.auth.uid
          || (isRider() && resource.data.riderId == request.auth.uid)));

      // Listing is restricted (queries must match these constraints).
      allow list: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (isRider() && resource.data.riderId == request.auth.uid);

      // Guests signed-out may create an order, but cannot forge
      // another user's uid, a rider, a final status or Paid payment.
      allow create: if (isAdmin()
          && request.resource.data.paymentStatus in ['Pending', 'COD'])
        || (
          request.resource.data.orderId == orderId
          && request.resource.data.status == 'Order Placed'
          && request.resource.data.paymentStatus in ['Pending', 'COD']
          && (request.resource.data.paymentStatus != 'COD'
            || request.resource.data.paymentOption == 'Cash on delivery')
          && request.resource.data.get('finalPrice', null) == null
          && request.resource.data.get('estimatedPrice', null) == null
          && request.resource.data.get('paymentOption', 'Quotation required') in ['Quotation required', 'Cash on delivery']
          && request.resource.data.get('riderId', null) == null
          && request.resource.data.get('statusHistory', []).size() == 1
          && request.resource.data.statusHistory[0].status == 'Order Placed'
          && (
            request.resource.data.get('customerUid', null) == null
            || (signedIn() && request.resource.data.customerUid == request.auth.uid)
          )
        );

      // Verified online payment status is changed only by trusted Functions.
      // Admins may manage order/shipment details but may not mark payments paid.
      allow update: if (isAdmin()
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && (resource.data.get('activePaymentReference', null) == null
            || (request.resource.data.finalPrice == resource.data.finalPrice
              && request.resource.data.paymentOption == resource.data.paymentOption
              && request.resource.data.status == resource.data.status)))
        || (
          isRider()
          && resource.data.riderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'statusHistory', 'updatedAt'])
          && request.resource.data.paymentStatus == resource.data.paymentStatus
        );

      allow delete: if isAdmin() && resource.data.get('activePaymentReference', null) == null;
    }

    /* ---------- Rider profiles mirror ---------- */
    match /riders/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isRider() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    /* ---------- Live rider locations (doc ID = orderId) ---------- */
    match /riderLocations/{orderId} {
      // Live GPS is returned only as a minimal projection by shipment lookup.
      allow get: if isAdmin()
        || (isRider() && resource.data.riderId == request.auth.uid);
      allow list: if isAdmin();

      // Only the rider assigned to that exact order may write their GPS.
      allow create, update: if isAdmin()
        || (
          isRider()
          && request.resource.data.riderId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid
        );
      allow delete: if isAdmin()
        || (
          isRider()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid
        );
    }

    /* ---------- Payments (verified state is Functions-only) ---------- */
    match /payments/{paymentId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* ---------- Carrier-independent shipments ---------- */
    match /shipments/{shipmentId} {
      // Customer shipment summaries are returned by listMyShipments.
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ---------- Tracking events (private raw records; expose via callable) ---------- */
    match /trackingEvents/{eventId} {
      // Customer timelines are returned by a sanitized tracking callable.
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ---------- Rate-limit records (Cloud Functions only) ---------- */
    match /trackingLookupLimits/{limitId} {
      allow read, write: if false;
    }

    /* ---------- Paystack webhook idempotency records (Functions only) ---------- */
    match /paymentWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    /* ---------- Public pricing (Admin → Pricing editor) ---------- */
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- Alert templates & settings (Functions read via Admin SDK) ---------- */
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    /* ---------- Alert log: written only by Cloud Functions ---------- */
    match /alerts/{alertId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ---------- Contact messages inbox ---------- */
    match /messages/{messageId} {
      allow create: if request.resource.data.get('read', false) == false
        && request.resource.data.keys().hasAll(['name', 'phone', 'message']);
      allow read, update, delete: if isAdmin();
    }

    /* ---------- Rider applications inbox ---------- */
    match /applications/{applicationId} {
      allow create: if request.resource.data.get('status', 'new') == 'new'
        && request.resource.data.keys().hasAll(['name', 'phone']);
      allow read, update, delete: if isAdmin();
    }
  }
}